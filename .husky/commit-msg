#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Get the signature status of the latest commit
SIGN_STATUS=$(git log -1 --pretty=%G? HEAD)

# Reject if the commit is not fully signed
# G = good signature (accepted)
# Anything else (N, B, U, X, R, Y, E) will be rejected
if [ "$SIGN_STATUS" != "G" ]; then
  echo "❌ Commit is not properly signed!"
  echo "Status: $SIGN_STATUS"
  echo "Use 'git commit -S' with a valid GPG key to sign your commit."
  exit 1
fi
